{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile with role and institution scope",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120,
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "REGULATORY_ADMIN",
            "REGULATORY_OFFICER",
            "INSTITUTION_COMPLIANCE_OFFICER",
            "INFRASTRUCTURE_REVIEWER",
            "PUBLIC_USER"
          ]
        },
        "institutionId": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "createdAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII for user profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "ApplicationRecord": {
      "title": "ApplicationRecord",
      "description": "Regulatory institution application record mirrored to Firestore",
      "type": "object",
      "properties": {
        "applicationId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "institutionId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "institutionName": {
          "type": "string",
          "maxLength": 200,
          "minLength": 2
        },
        "category": {
          "type": "string",
          "maxLength": 120
        },
        "academicYear": {
          "type": "string",
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "enum": [
            "New",
            "Processing",
            "Findings Generated",
            "Awaiting Source Verification",
            "Awaiting Institution Response",
            "Awaiting Manual Review",
            "Review Completed",
            "Closed"
          ]
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "syntheticLabel": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "applicationId",
        "institutionId",
        "institutionName",
        "category",
        "academicYear",
        "status",
        "ownerUid",
        "syntheticLabel",
        "createdAt",
        "updatedAt"
      ]
    },
    "ReviewObservation": {
      "title": "ReviewObservation",
      "description": "Reviewer action or observation linked to an application",
      "type": "object",
      "properties": {
        "observationId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "applicationId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actionType": {
          "type": "string",
          "enum": [
            "ACCEPT_FINDING",
            "DISMISS_FINDING",
            "REQUEST_EVIDENCE",
            "ESCALATE",
            "OBSERVATION",
            "RECOMMENDATION"
          ]
        },
        "justification": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 3
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "observationId",
        "applicationId",
        "authorUid",
        "actionType",
        "justification",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public user profile and non-sensitive role metadata"
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Strictly isolated PII document for the user"
    },
    "/applications/{applicationId}": {
      "schema": { "$ref": "#/entities/ApplicationRecord" },
      "description": "Application records scoped by ownerUid or admin"
    },
    "/applications/{applicationId}/observations/{observationId}": {
      "schema": { "$ref": "#/entities/ReviewObservation" },
      "description": "Subcollection of review observations under an application"
    }
  }
}
