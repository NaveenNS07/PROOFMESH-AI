rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'mmnaveen202006@gmail.com'
      );
    }

    // Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'role', 'institutionId', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.role is string && data.role in [
          'REGULATORY_ADMIN',
          'REGULATORY_OFFICER',
          'INSTITUTION_COMPLIANCE_OFFICER',
          'INFRASTRUCTURE_REVIEWER',
          'PUBLIC_USER'
        ] &&
        (!('institutionId' in data) || (data.institutionId is string && data.institutionId.size() <= 64)) &&
        data.createdAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.createdAt is timestamp;
    }

    function isValidApplicationRecord(data) {
      return data.keys().hasAll([
          'applicationId',
          'institutionId',
          'institutionName',
          'category',
          'academicYear',
          'status',
          'ownerUid',
          'syntheticLabel',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'applicationId',
          'institutionId',
          'institutionName',
          'category',
          'academicYear',
          'status',
          'ownerUid',
          'syntheticLabel',
          'createdAt',
          'updatedAt'
        ]) &&
        data.applicationId is string && data.applicationId.size() >= 1 && data.applicationId.size() <= 64 && data.applicationId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.institutionId is string && data.institutionId.size() >= 1 && data.institutionId.size() <= 64 && data.institutionId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.institutionName is string && data.institutionName.size() >= 2 && data.institutionName.size() <= 200 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 120 &&
        data.academicYear is string && data.academicYear.size() >= 4 && data.academicYear.size() <= 20 &&
        data.status is string && data.status in [
          'New',
          'Processing',
          'Findings Generated',
          'Awaiting Source Verification',
          'Awaiting Institution Response',
          'Awaiting Manual Review',
          'Review Completed',
          'Closed'
        ] &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 && data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == request.auth.uid &&
        data.syntheticLabel is string && data.syntheticLabel.size() >= 1 && data.syntheticLabel.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReviewObservation(data) {
      return data.keys().hasAll([
          'observationId',
          'applicationId',
          'authorUid',
          'actionType',
          'justification',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'observationId',
          'applicationId',
          'authorUid',
          'actionType',
          'justification',
          'createdAt'
        ]) &&
        data.observationId is string && data.observationId.size() >= 1 && data.observationId.size() <= 64 && data.observationId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.applicationId is string && data.applicationId.size() >= 1 && data.applicationId.size() <= 64 && data.applicationId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 && data.authorUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorUid == request.auth.uid &&
        data.actionType is string && data.actionType in [
          'ACCEPT_FINDING',
          'DISMISS_FINDING',
          'REQUEST_EVIDENCE',
          'ESCALATE',
          'OBSERVATION',
          'RECOMMENDATION'
        ] &&
        data.justification is string && data.justification.size() >= 3 && data.justification.size() <= 1000 &&
        data.createdAt is timestamp;
    }

    // Admins Registry (Read-only for self/admin, no client writes)
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list, create, update, delete: if false;
    }

    // User Profiles (Public non-PII profile)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        (incoming().role != 'REGULATORY_ADMIN' || isAdmin());
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt && (
          isAdmin() || (
            isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'institutionId'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();

      // Isolated PII Subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow list: if false;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          isOwner(userId) &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          isOwner(userId) &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email']) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidId(docId) && isAdmin();
      }
    }

    // Applications Collection
    match /applications/{applicationId} {
      allow get: if isValidId(applicationId) && isSignedIn() && (
        existing().ownerUid == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || isAdmin()
      );
      allow create: if isVerifiedUser() &&
        isValidId(applicationId) &&
        incoming().applicationId == applicationId &&
        isValidApplicationRecord(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(applicationId) &&
        isValidApplicationRecord(incoming()) &&
        incoming().applicationId == existing().applicationId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            existing().ownerUid == request.auth.uid &&
            existing().status != 'Closed' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'category', 'academicYear'])
          )
        );
      allow delete: if isValidId(applicationId) && isAdmin();

      // Observations Subcollection (Master Gate Pattern)
      match /observations/{observationId} {
        allow get: if isValidId(applicationId) && isValidId(observationId) && isSignedIn() && (
          get(/databases/$(database)/documents/applications/$(applicationId)).data.ownerUid == request.auth.uid ||
          isAdmin()
        );
        allow list: if isSignedIn() && (
          resource.data.authorUid == request.auth.uid || isAdmin()
        );
        allow create: if isVerifiedUser() &&
          isValidId(applicationId) &&
          isValidId(observationId) &&
          incoming().observationId == observationId &&
          incoming().applicationId == applicationId &&
          isValidReviewObservation(incoming()) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/applications/$(applicationId)) && (
            get(/databases/$(database)/documents/applications/$(applicationId)).data.ownerUid == request.auth.uid ||
            isAdmin()
          );
        allow update, delete: if false;
      }
    }
  }
}
